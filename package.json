{
  "name": "worldsim2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador de historia emergente zero-player en la web",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ws/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:root && pnpm lint:deps",
    "lint:root": "eslint --max-warnings=0 \"*.js\" \"scripts/**/*.mjs\"",
    "lint:deps": "depcruise apps packages tools spikes --config .dependency-cruiser.cjs",
    "test": "turbo run test",
    "bench": "ws bench",
    "ws": "ws",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site": "node scripts/assemble-site.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@ws/cli": "workspace:*",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,yml,yaml,css,html}": "prettier --write"
  }
}
