{
  "name": "@ws/determinism",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Suite de determinismo permanente (P1.0): mismo hash por año en Node, Chromium, Firefox y WebKit con el motor real",
  "scripts": {
    "dev": "vite",
